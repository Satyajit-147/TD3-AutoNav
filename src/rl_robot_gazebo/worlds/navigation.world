      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1 1</size></box></geometry><material><ambient>0.8 0.2 0.1 1</ambient></material></visual>
